{
    "name": "usdoj/foia",
    "description": "Drupal 8 FOIA site built with BLT.",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "acquia/drupal-environment-detector": "1.6.0",
        "acquia/memcache-settings": "*",
        "composer/installers": "^2.2.0",
        "cweagans/composer-patches": "^1.7.3",
        "dompdf/dompdf": "^2.0.3",
        "drupal/acquia_connector": "^4.0.4",
        "drupal/acquia_purge": "^1.3.0",
        "drupal/action": "^0.2",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/auto_entitylabel": "^3.0@beta",
        "drupal/autologout": "^2.0",
        "drupal/autosave_form": "^1.6",
        "drupal/bartik": "^1.0",
        "drupal/config_split": "^2.0",
        "drupal/confirm_leave": "^1.0@beta",
        "drupal/consumers": "^1.17",
        "drupal/core": "11.3.12",
        "drupal/core-composer-scaffold": "11.3.12",
        "drupal/core-dev": "11.3.12",
        "drupal/core-project-message": "11.3.11",
        "drupal/core-recommended": "11.3.12",
        "drupal/core-vendor-hardening": "^10.3.1",
        "drupal/core_context": "*",
        "drupal/ctools": "^4.1",
        "drupal/ctools_block": "^4.0",
        "drupal/devel": "^5.4",
        "drupal/diff": "^1.10",
        "drupal/entity_block": "^2.0",
        "drupal/entity_browser": "^2.9",
        "drupal/entity_clone": "^2.2@beta",
        "drupal/entity_embed": "^1.4.0",
        "drupal/entity_reference_revisions": "^1.10.0",
        "drupal/entity_reference_views_select": "^1.5.0",
        "drupal/externalauth": "^2.0",
        "drupal/feeds": "3.x-dev@dev",
        "drupal/feeds_ex": "^1.0@beta",
        "drupal/field_group": "^4.0",
        "drupal/field_permissions": "^1.2",
        "drupal/file_entity": "^2.0@RC",
        "drupal/form_mode_manager": "^3.1",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/insert": "^3.0@beta",
        "drupal/jquery_once": "^1.0",
        "drupal/jquery_ui_accordion": "^2.0",
        "drupal/js_cookie": "^1.0",
        "drupal/jsonapi_extras": "^3.23",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/layout_builder_styles": "^2.0",
        "drupal/layout_library": "^1.0@beta",
        "drupal/maillog": "^1.1",
        "drupal/mailsystem": "^4.4.0",
        "drupal/masquerade": "^2.0.0-rc1",
        "drupal/media_entity_instagram": "^4.0",
        "drupal/media_entity_twitter": "^2.9",
        "drupal/metatag": "^2.0.0",
        "drupal/migrate_plus": "^6.0.1",
        "drupal/migrate_tools": "^6.1",
        "drupal/node_edit_protection": "^1.1.0",
        "drupal/node_revision_delete": "^2.1",
        "drupal/openapi": "^2.1.0",
        "drupal/panels": "^4.7",
        "drupal/paragraphs": "^1.15.0",
        "drupal/password_policy": "^4.0",
        "drupal/precision_modifier": "^2.0",
        "drupal/queue_ui": "^3.1",
        "drupal/quickedit": "^2.0",
        "drupal/rdf": "^3.0@beta",
        "drupal/recaptcha": "^3.4",
        "drupal/restui": "^1.21.0",
        "drupal/roleassign": "^2.0.0",
        "drupal/samlauth": "^3.13",
        "drupal/schemata": "^1.0@beta",
        "drupal/search_api": "^1.29",
        "drupal/seckit": "^2.0",
        "drupal/select2": "^2.0",
        "drupal/seven": "^2.0@beta",
        "drupal/shield": "^1.7.0",
        "drupal/simplesamlphp_auth": "^4.1",
        "drupal/symfony_mailer": "^2.0",
        "drupal/time_field": "^2.1.0",
        "drupal/typed_data": "^2.1",
        "drupal/upgrade_status": "^4.0",
        "drupal/video_embed_field": "^3.1",
        "drupal/view_unpublished": "^1.1.0",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_data_export": "^1.10",
        "drupal/views_infinite_scroll": "^2.0.1",
        "drupal/webform": "^6.3@RC",
        "drupal/xmlsitemap": "^2.0",
        "drush/drush": "^13",
        "egulias/email-validator": "^4.0.0",
        "guzzlehttp/guzzle": "^7.7",
        "mglaman/composer-drupal-lenient": "^1.0",
        "mglaman/phpstan-drupal": "^2.0",
        "npm-asset/jquery-validation": "^1.19.5",
        "npm-asset/select2": "^4.0",
        "oomphinc/composer-installers-extender": "^2",
        "symfony/console": "~v7.4.11",
        "symfony/mime": "^7.4.12",
        "symfony/routing": "^7.4.13",
        "twig/twig": "^3.6"
    },

    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./docroot"
            },
            "file-mapping": {
                "[web-root]/.htaccess": false,
                "[web-root]/robots.txt": false,
                "[web-root]/sites/development.services.yml": false,
                "[project-root]/.editorconfig": false,
                "[project-root]/.gitattributes": false
            }
        },
        "enable-patching": true,
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush",
                "type:drupal-drush"
            ]
        },
        "patches": {
            "drupal/core": {
                "FOIA-32: Dynamically provide action plugins for every moderation state change": "https://www.drupal.org/files/issues/2019-11-20/2797583_provide_moderation_states_as_actions_128.patch",
                "FOIA-32: Exclude Agency/Component from validation for bulk publishing": "./patches/FOIA-32-validator.patch",
                "2230909 - Simple decimals fail to pass validation": "https://www.drupal.org/files/issues/2026-03-30/2230909-simple-decimals-fail-validation-11.3.x-hacky-disable-validation-MR152288.patch"
            },
            "drupal/paragraphs": {
                "Inline Paragraphs widget performance update": "./patches/paragraphs-improve-performance-2935134.patch",
                "Paragraph access check using incorrect revision of its parent https://www.drupal.org/project/paragraphs/issues/3090200#comment-14762651": "./patches/3084934-13_combine_3090200-22.patch"
            },
            "drupal/simplesamlphp_auth": {
                "Masquerade and Logout Fix": "./patches/FOIA-78964-simplesamlphp-logout.patch"
            },
            "drupal/ckeditor5": {
                "Drupal 10: Install Error: https://www.drupal.org/project/ckeditor5_font/issues/3318041": "https://www.drupal.org/files/issues/2022-12-16/2-fix-empty-form-value-validation.patch"
            },
            "drupal/views": {
                "Drupal 10: TEMP VIEWS: https://www.drupal.org/project/drupal/issues/3150368": "https://www.drupal.org/files/issues/2020-06-09/EntityViewsData_MapDefinition_Null-3150368-1.patch"
            },
            "drupal/maillog": {
                "Fix Maillog": "https://www.drupal.org/files/issues/2023-01-12/maillog_3259616-15.patch"
            },
            "drupal/autologout": {
              "Avoid problematic interactions with the confirm_leave module": "./patches/autologout-support-for-confirm_leave.patch"
            },
	    "drupal/precision_modifier": {
                "#3433963 Automated Drupal 11 compatibility fixes for precision_modifier": "https://www.drupal.org/files/issues/2026-04-10/precision_modifier_2.0.patch"
	    },
	    "drupal/symfony_mailer": {
                "#3589038 CommentLinkBuilderInterface not found": "https://www.drupal.org/files/issues/2026-05-13/symfony_mailer-3589038-mailerpass-class-exists-guard.patch"
	    }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-lenient": {
            "allowed-list": ["drupal/business_rules", "drupal/rules", "egulias/email-validator", "drupal/simplesamlphp_auth", "drupal/form_mode_manager", "drupal/ctools", "drupal/precision_modifier" ]
        }
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "exclude": ["drupal/panelizer", "drupal/business_rules", "drupal/dbug"]
        },
        "asset-packagist": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        "npm-assets": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        "drupal/panelizer": {
            "type": "vcs",
            "url": "https://git.drupalcode.org/issue/panelizer-3352704.git"
        },
        "drupal/business_rules": {
            "type": "vcs",
            "url": "https://git.drupalcode.org/issue/business_rules-3286389.git"
        },
        "drupal/dbug": {
            "type": "vcs",
            "url" : "https://git.drupalcode.org/issue/dbug-3286928.git"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "mglaman/composer-drupal-lenient": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "simplesamlphp/composer-module-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.3.24"
        },
        "audit": {
            "block-insecure": true 
        }
    },
    "autoload": {
        "psr-4": {
            "Example\\": "blt/src/"
        },
        "classmap": []
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\PHPUnit\\": "tests/phpunit/src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "blt internal:create-project:init-repo"
        ],
        "nuke": [
            "rm -rf vendor composer.lock docroot/core docroot/modules/contrib docroot/profiles/contrib docroot/themes/contrib",
            "@composer clearcache --ansi",
            "@composer install --ansi"
        ]
    },
    "require-dev": {
        "behat/behat": "*",
        "behat/gherkin": "^4.9",
        "behat/mink": "^1.10",
        "behat/mink-browserkit-driver": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "dmore/behat-chrome-extension": "^1.4",
        "drevops/behat-screenshot": "^1.2",
        "drupal/drupal-extension": "^5.0@RC",
        "imbo/behat-api-extension": "^5.0",
        "jarnaiz/behat-junit-formatter": "^1.3"
    }
}
